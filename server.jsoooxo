const express = require('express');
const http = require('http');
const { Server } = require('socket.io');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

app.use(express.static('public'));

let waitingUser = null;
let activeUsers = {}; // Stores all online users and their gender

function updateAdminStats() {
    let total = Object.keys(activeUsers).length;
    let male = 0;
    let female = 0;

    for (let id in activeUsers) {
        if (activeUsers[id] === 'Male') male++;
        else if (activeUsers[id] === 'Female') female++;
    }

    io.emit('update-stats', { total, male, female, activeUsers });
}

io.on('connection', (socket) => {
    console.log(`Connected ID: ${socket.id}`);
    activeUsers[socket.id] = 'Unknown';

    updateAdminStats();

    socket.on('set-gender', (gender) => {
        activeUsers[socket.id] = gender;
        updateAdminStats();
    });

    socket.on('find-partner', () => {
        if (waitingUser && waitingUser.id !== socket.id) {
            const room = `${waitingUser.id}#${socket.id}`;
            waitingUser.join(room);
            socket.join(room);

            io.to(room).emit('matched', room);
            waitingUser = null;
        } else {
            waitingUser = socket;
            socket.emit('waiting', 'Searching for a stranger...');
        }
    });

    socket.on('message', ({ room, message }) => {
        socket.to(room).emit('message', message);
    });

    socket.on('leave-room', (room) => {
        socket.leave(room);
        socket.to(room).emit('partner-disconnected');
    });

    socket.on('disconnect', () => {
        if (waitingUser === socket) {
            waitingUser = null;
        }
        
        const rooms = Array.from(socket.rooms);
        rooms.forEach(room => {
            if (room !== socket.id) {
                socket.to(room).emit('partner-disconnected');
            }
        });

        delete activeUsers[socket.id];
        updateAdminStats();
        console.log(`Disconnected ID: ${socket.id}`);
    });
});

const PORT = 3000;
server.listen(PORT, '0.0.0.0', () => {
    console.log('--------------------------------------------------');
    console.log('🚀 Server started successfully!');
    console.log(`📱 User Chat Site: http://localhost:${PORT}`);
    console.log(`👑 Admin Dashboard: http://localhost:${PORT}/admin.html`);
    console.log('--------------------------------------------------');
});














